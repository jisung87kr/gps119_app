# docker compose «전용» 환경파일. 서버에서 `.env.deploy` 로 복사해 채운다.
#
# ⚠️ Laravel 의 `src/.env` 와 «다른 파일»이고, 둘 다 필요하다.
#    - 이 파일: 컨테이너를 «띄우는» 데 필요한 값 (MySQL 초기화, Apache ServerName)
#    - src/.env: 애플리케이션이 «동작하는» 데 필요한 값 (APP_KEY, VAPID, FCM …)
#    DB 이름·계정·비밀번호는 양쪽에 같은 값이 들어가야 한다. 어긋나면 앱만 DB 접속에 실패한다.

# Apache ServerName / 인증서 경로에 쓰인다. 실제 서비스 도메인.
APP_DOMAIN=gps119.example.com

# MySQL 컨테이너 초기화 값. 최초 기동 시 «한 번만» 반영된다 —
# 이미 볼륨이 만들어진 뒤 여기를 고쳐도 비밀번호는 바뀌지 않는다.
DB_DATABASE=gps119
DB_USERNAME=gps119
DB_PASSWORD=
DB_ROOT_PASSWORD=
