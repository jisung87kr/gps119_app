# 운영용 Laravel 환경변수 템플릿. 서버에서 `src/.env` 로 «복사해» 채운다.
# (`.env.production` 이라는 이름 그대로 두면 .gitignore 에 걸려 배포 때 헷갈린다)
#
# 로컬 개발용 `.env` 와 헷갈리지 않게, 값이 다르거나 함정이 있는 항목에만 주석을 달았다.

APP_NAME=GPS119
APP_ENV=production
# php artisan key:generate 로 «서버에서» 생성한다. 로컬 키를 복사해 오지 않는다.
APP_KEY=
# 🔴 운영에서 true 면 스택트레이스에 DB 접속정보·토큰이 그대로 노출된다.
APP_DEBUG=false
APP_URL=https://gps119.example.com

APP_LOCALE=ko
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ko_KR
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# debug 로 두면 4GB 인스턴스에서 디스크가 먼저 찬다.
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
# .env.deploy 의 DB_* 와 «같은 값»이어야 한다.
DB_DATABASE=gps119
DB_USERNAME=gps119
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# 앱 셸(Capacitor)이 원격 URL 로 붙어도 세션이 유지되려면 오리진이 정확히 일치해야 한다.
SESSION_DOMAIN=gps119.example.com
# https 전용 서버이므로 켠다. 켜두면 http 로 새는 경로에서 쿠키가 안 나간다.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@gps119.example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# 미설정이면 AnnounceRequestToDiscord 가 조용히 건너뛴다(의도된 동작).
DISCORD_WEBHOOK_URL=

# --- 소셜 로그인 --- 콘솔의 Redirect URI 를 운영 도메인으로 «먼저» 등록해야 한다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=https://gps119.example.com/auth/naver/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://gps119.example.com/auth/kakao/callback

# --- Reverb ---
# 서버측 publish 대상. 컨테이너 안에서 app → reverb 로 가는 경로다.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=gps119.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# 🔑 VITE_REVERB_* 는 «비워 둔다».
#    echo.js 의 resolveReverbConfig 가 window.location 에서 호스트·포트·스킴을 유도한다.
#    여기에 값을 넣으면 빌드 시점에 호스트가 «상수로 박히고», 그 방식으로 이미 두 번 깨졌다
#    (LAN IP 변경 시 재빌드 전까지 복구 불가 / https 페이지에서 ws:// 가 혼합콘텐츠 차단).
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=
VITE_REVERB_PORT=
VITE_REVERB_SCHEME=

# --- 웹 푸시(VAPID) ---
# php artisan push:vapid-keys 로 생성. ⚠️ 교체하면 기존 구독이 «전부» 무효가 된다.
VAPID_SUBJECT=mailto:admin@gps119.example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- 앱 푸시(FCM) ---
# 서비스 계정 JSON 은 git 에 없다. 서버에 직접 올리고 경로를 적는다.
# storage/ 아래에 두면 웹으로 노출되지 않는다(public/ 아래에 두지 말 것).
FCM_PROJECT_ID=
FCM_CREDENTIALS=/var/www/html/storage/app/fcm-service-account.json

# 앱 셸·SPA 가 세션 쿠키로 /api/* 를 호출하려면 여기 도메인이 있어야 한다.
SANCTUM_STATEFUL_DOMAINS=gps119.example.com
