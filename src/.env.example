APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# 신규 신고 운영 공지(선택). 미설정이면 AnnounceRequestToDiscord 가 건너뛴다.
DISCORD_WEBHOOK_URL=

# 웹 푸시(VAPID). 생성: php artisan push:vapid-keys
# 키를 «바꾸면» 기존 구독이 전부 무효가 되고 사용자가 알림을 다시 허용해야 한다.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# FCM(앱 푸시). 미설정이 정상 — 스토어·FCM 명의 주체(N0-4) 확정 후에 켠다.
FCM_PROJECT_ID=
FCM_CREDENTIALS=

# 웹뷰 앱 인증의 전제 (mobile-app N2). 쉼표 구분, 포트까지 정확히 일치해야 한다.
# 빠지면 /api/* 와 /broadcasting/auth 가 401 이 되어 실시간이 통째로 죽는다.
# 미설정 시 config/sanctum.php 의 기본값(로컬 + 레거시 도메인)이 쓰인다.
SANCTUM_STATEFUL_DOMAINS=
